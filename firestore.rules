rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // INTERNAL TAHFIDZ
    // Semua user yang berhasil login Firebase Authentication
    // dianggap user internal dan memiliki akses penuh.
    // Tidak ada role admin/guru di Firestore.
    // =========================================================

    match /tahfidz_siswa/{nis} {
      allow read, write:
        if request.auth != null;
    }

    match /tahfidz_setoran/{id} {
      allow read, write:
        if request.auth != null;
    }

    match /tahfidz_catatan/{id} {
      allow read, write:
        if request.auth != null;
    }

    match /tahfidz_surah/{id} {
      allow read:
        if true;

      allow write:
        if request.auth != null;
    }


    // =========================================================
    // PORTAL ORANG TUA
    //
    // Orang tua tidak login.
    // Akses memakai NIS dan hanya projection non-private.
    //
    // Struktur:
    // tahfidz_portal/{nis}
    //    ├── nama
    //    ├── kelas
    //    └── setoran/{id}
    //    └── catatan/{id}
    //    └── juziyah/{id}
    //
    // Tidak ada password / akun orang tua.
    // =========================================================

    match /tahfidz_portal/{nis} {
      allow read:
        if true;

      allow write:
        if request.auth != null;

      match /setoran/{id} {
        allow read:
          if true;

        allow write:
          if request.auth != null;
      }

      match /catatan/{id} {
        allow read:
          if true;

        allow write:
          if request.auth != null;
      }

      match /juziyah/{id} {
        allow read:
          if true;

        allow write:
          if request.auth != null;
      }
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
